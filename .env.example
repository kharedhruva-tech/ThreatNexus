# FalkorDB Primary Database Connection
FALKORDB_HOST=127.0.0.1
FALKORDB_PORT=6379
FALKORDB_PASSWORD=
GRAPH_NAME=contextgraph

# Application Bounds & Agent Configuration
MAX_TRAVERSAL_DEPTH=3
MAX_QUERY_RESULTS=50

# Model Context Protocol (MCP) Server
MCP_HOST=127.0.0.1
MCP_PORT=8000

# Agent Operating Mode (Zero Paid APIs)
# Mode options: deterministic (default, no LLM required) or ollama (local offline LLM)
AGENT_MODE=deterministic

# Optional Local Ollama Configuration (Only accessed if AGENT_MODE=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:latest
OLLAMA_TIMEOUT=30.0

# Frontend Configuration
VITE_API_BASE_URL=http://127.0.0.1:8080

